# Tout ce qui n'est pas nécessaire à `next build` (allège le contexte et évite
# d'embarquer secrets ou artefacts locaux dans l'image).
.git
.github
.githooks
.next
.next-e2e
.next-e2e-verify
node_modules
.env
.env.*
!.env.example
!.env.test.example
ios
android
docs
scripts/bench
test-results
playwright-report
*.har
*.log
.DS_Store
.idea
# Contexte agent, clés et fichiers locaux (jamais dans une couche d'image).
.claude
*.pem
*.local
coverage
supabase/.temp
_bmad*
temp
