# Base de données — PostgREST auto-hébergé sur le VPS (docs/infra/migration-supabase-vps.md).
# URL interne du service Dokploy + JWT `role: service_role` signé avec son PGRST_JWT_SECRET.
DATABASE_REST_URL=
DATABASE_REST_KEY=

# Supabase — repli tant que DATABASE_REST_* sont absentes (base) ou que S3_BUCKET
# est absent (photos). Utilisé aussi par le harnais E2E (Supabase local).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Photos — OVH Object Storage S3 (objets publics en ACL public-read). S3_BUCKET
# active le pilote ; sans lui, les photos vont sur Supabase Storage.
S3_BUCKET=
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Session signing — must be at least 32 characters, generate with: openssl rand -base64 32
SESSION_SIGNING_SECRET=

# Origine publique de l'app, sans slash final (ex. https://mijote.anthonykocken.fr).
# Source de vérité des liens absolus (magic links, partage, metadataBase). À poser
# OBLIGATOIREMENT derrière un reverse proxy auto-hébergé (Traefik/Dokploy) : sinon
# l'origine est dérivée des en-têtes Host / x-forwarded-host, forgeables par le
# client (empoisonnement des magic links) — voir src/lib/request-origin.ts.
APP_ORIGIN=

# Redis (rate limiting, cache de révocation des sessions), protocole REST Upstash.
# Staging/prod : proxy serverless-redis-http devant le Redis du VPS (Dokploy).
# Poste : Redis local du harnais E2E (`npm run test:e2e:setup`, port 8079, jeton
# de .env.test.local). Upstash n'est plus utilisé depuis le 2026-09-12.
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=

# Demo household — UUID of the permanent demo household (set after running supabase/seed.sql)
# After seeding: SELECT id FROM households WHERE is_demo = true;
# Default seed.sql value: 00000000-0000-0000-0000-000000000000
DEMO_HOUSEHOLD_ID=

# A/B onboarding (backlog #25, optionnel) — 1 = tirage 50/50 par appareil au
# premier rendu de la landing (bras B : « Commencer » en primaire). Absent ou 0 :
# landing actuelle pour tout le monde, aucun cookie posé.
AB_ONBOARDING_ENABLED=

# OpenAI — enrichissement & imports IA (modèles centralisés dans src/lib/ai-models.ts)
OPENAI_SERVICE_KEY=

# Apify — recipe import from Instagram + anti-blocking crawler fallback
# (optional: URL import works without it, minus Instagram & the block fallback)
APIFY_TOKEN=

# Cron jobs — secret token for protected cron route handlers
CRON_SECRET=

# Sentry — error reporting (optional: everything no-ops when unset)
# DSN is public by design (it only allows submitting events)
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map upload (Docker build via GitHub Actions)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
