# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Session signing — must be at least 32 characters, generate with: openssl rand -base64 32
SESSION_SIGNING_SECRET=

# Origine publique de l'app, sans slash final (ex. https://mijote.anthonykocken.fr).
# Source de vérité des liens absolus (magic links, partage, metadataBase). À poser
# OBLIGATOIREMENT derrière un reverse proxy auto-hébergé (Traefik/Dokploy) : sinon
# l'origine est dérivée des en-têtes Host / x-forwarded-host, forgeables par le
# client (empoisonnement des magic links) — voir src/lib/request-origin.ts.
APP_ORIGIN=

# Upstash Redis — for rate limiting and session revocation cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Demo household — UUID of the permanent demo household (set after running supabase/seed.sql)
# After seeding: SELECT id FROM households WHERE is_demo = true;
# Default seed.sql value: 00000000-0000-0000-0000-000000000000
DEMO_HOUSEHOLD_ID=

# OpenAI — enrichissement & imports IA (modèles centralisés dans src/lib/ai-models.ts)
OPENAI_SERVICE_KEY=

# Apify — recipe import from Instagram + anti-blocking crawler fallback
# (optional: URL import works without it, minus Instagram & the block fallback)
APIFY_TOKEN=

# Cron jobs — secret token for protected cron route handlers
CRON_SECRET=

# Sentry — error reporting (optional: everything no-ops when unset)
# DSN is public by design (it only allows submitting events)
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map upload (Docker build via GitHub Actions)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
